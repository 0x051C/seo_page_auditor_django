# Copy this file to .env and adjust. Never commit .env.

# Django
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Search Console: "mock" (sample data, no credentials) or "google" (real API)
GSC_BACKEND=mock
# Only needed for GSC_BACKEND=google: path to a service-account JSON key.
# Add the service account's email as a user on the Search Console property.
GOOGLE_APPLICATION_CREDENTIALS=
